# URL of the FastAPI backend (web_server.py). Leave empty to run in DEMO mode
# with the bundled 168 alerts + 3,191 receptors (read-only, no live scans).
BACKEND_URL=http://127.0.0.1:8000

# Inspector login. Confirm / Reject / scan / pause actions require it.
# If INSPECTOR_PASSWORD is empty, those actions are disabled for everyone.
INSPECTOR_PASSWORD=change-me
# Random string (32+ chars) used to sign the session cookie.
AUTH_SECRET=replace-with-a-long-random-string

# Only set to "false" for an HTTP-only test server (no domain/HTTPS yet), otherwise login
# cookies are rejected by the browser. Leave unset in production behind HTTPS.
# COOKIE_SECURE=false
