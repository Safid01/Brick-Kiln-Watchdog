[Unit]
Description=Brick Kiln Watchdog - Next.js dashboard
After=network-online.target kiln-backend.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=NODE_ENV=production
# .env.local (BACKEND_URL, INSPECTOR_PASSWORD, AUTH_SECRET) is loaded by Next.js from WorkingDirectory.
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
